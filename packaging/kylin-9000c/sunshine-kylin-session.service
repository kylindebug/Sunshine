[Unit]
Description=Sunshine UKUI stream session protection
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/libexec/sunshine-kylin-session.py --socket %t/sunshine-session/guard.sock --journal %h/.config/sunshine-kylin/session-guard.json
Restart=on-failure
RestartSec=1
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
UMask=0077

[Install]
WantedBy=graphical-session.target
